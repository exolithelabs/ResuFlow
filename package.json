{
  "name": "resuflow",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Downloadable local resume builder with desktop, browser, CLI, and MCP access.",
  "license": "Apache-2.0",
  "author": "ResuFlow contributors",
  "keywords": [
    "resume",
    "cv",
    "local-first",
    "tauri",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exolithelabs/resuflow.git"
  },
  "homepage": "https://github.com/exolithelabs/resuflow#readme",
  "bugs": {
    "url": "https://github.com/exolithelabs/resuflow/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run version:check && npm run distro:check && npm test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs --set",
    "distro:check": "node scripts/distro-check.mjs",
    "distro:build": "bash distro/linux/build-arch-package.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
