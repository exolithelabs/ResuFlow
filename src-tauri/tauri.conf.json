{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResuFlow",
  "version": "0.2.0",
  "identifier": "dev.resuflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResuFlow",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Dhiraj Yadav",
    "copyright": "Copyright 2026 Dhiraj Yadav. Licensed under the Apache License, Version 2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/exolithelabs/ResuFlow",
    "category": "Productivity",
    "shortDescription": "Local-first resume builder with an MCP server for AI agents",
    "longDescription": "Write resumes as plain Markdown on your own computer, alone or with your AI agent. ResuFlow is a desktop app and a local stdio MCP server in one binary.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNkJFODFGQzg5N0IwNEUKUldST3NKZklIK2hyWW9ITCs2elVWc3VjSS9oZzU0QzZKWXkzeE0xRUIzVDNWOTNQL2lHd1gyb24K",
      "endpoints": [
        "https://github.com/exolithelabs/ResuFlow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
